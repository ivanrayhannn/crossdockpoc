digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.45, pad=0.3, newrank=true, label="ASN04 ASN Upload (batch) - TO-BE (CR Crossdock)", labelloc=t, fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6B7F", fontname="Helvetica", fontsize=10, margin="0.12,0.06", width=1.6];
  edge [color="#5B6B7F", fontname="Helvetica", fontsize=9, arrowsize=0.7];
  subgraph cluster_sup { label="Supplier"; style="filled"; fillcolor="#F7FBFF"; color="#BFBFBF"; fontsize=11; labeljust=l;
    s1 [label="Fill upload template\n(Manifest No, Part No, Qty,\nPalletize Code, Case No...)"];
    s2 [label="[Upload] on\nASN Creation"];
    s3 [label="Read result / log"];
    s4 [label="Remove crossdock rows;\ntheir ASN on the other screen\nASN Creation (Crossdock)", fillcolor="#E2EFDA" color="#548235"];
  }
  subgraph cluster_nsp { label="NSP - ASN existing (ASN04 batch)"; style="filled"; fillcolor="#FFFFFF"; color="#BFBFBF"; fontsize=11; labeljust=l;
    b1 [label="Format, mandatory\nand duplication\nchecks (4b)"];
    b2 [label="Palletize Code X?", shape=diamond, width=1.9, fillcolor="#FFF2CC" color="#C55A11" penwidth=2];
    b3 [label="Manifest with\nCROSS_DOCK_FLAG X?", shape=diamond, width=2.1, fillcolor="#FFF2CC" color="#C55A11" penwidth=2];
    e12 [label="Validation error\nmsg 12 (line)", fillcolor="#FFF2CC" color="#C55A11" penwidth=2];
    e13 [label="Validation error\nmsg 13 (line)", fillcolor="#FFF2CC" color="#C55A11" penwidth=2];
    b4 [label="Crossdock checks\nmsg 8 (delivery qty)\nmsg 9 (case no / palletize)\nDELETED", fillcolor="#F2F2F2" color="#A6A6A6" fontcolor="#7F7F7F" style="rounded,filled,dashed"];
    b5 [label="Existing business\nchecks"];
    b6 [label="Any error?", shape=diamond, width=1.3];
    b7 [label="Finished with error\n(msg 7b), nothing saved"];
    b8 [label="Insert temporary ->\nTB_T_ASN draft;\nSubmit as in ASN Creation"];
  }
  subgraph cluster_xd { label="NSP - ASN Crossdock (new)"; style="filled"; fillcolor="#F4FAF0"; color="#BFBFBF"; fontsize=11; labeljust=l;
    x1 [label="ASN Creation (Crossdock)\n(XD10)", fillcolor="#E2EFDA" color="#548235"];
  }
  subgraph cluster_db { label="Database"; style="filled"; fillcolor="#FAFAFA"; color="#BFBFBF"; fontsize=11; labeljust=l;
    db_pm [shape=cylinder, label="TB_R_PRA_DAILY_ORDER_MANIFEST\n(CROSS_DOCK_FLAG)"];
    db_pp [shape=cylinder, label="TB_R_PRA_DAILY_ORDER_PART\n(Palletize Code, remaining qty)"];
    db_asn [shape=cylinder, label="TB_T_ASN\n(draft)"];
    db_dm [shape=cylinder, label="TB_R_DAILY_ORDER_MANIFEST"];
    db_dp [shape=cylinder, label="TB_R_DAILY_ORDER_PART"];
  }
  s1 -> s2 -> b1 -> b2;
  b2 -> e12 [label="Yes"]; b2 -> b3 [label="No"]; b3 -> e13 [label="Yes"]; b3 -> b5 [label="No"];
  e12 -> b6; e13 -> b6; b5 -> b6; b6 -> b7 [label="Yes"]; b6 -> b8 [label="No"]; b7 -> s3; b8 -> s3;
  s3 -> s4 [style=dashed, label="crossdock rows"]; s4 -> x1;
  b4 -> b5 [style=invis];
  db_pm -> b3 [style=dashed, label="read flag", constraint=false]; b8 -> db_asn [style=dashed, constraint=false];
  { rank=same; b3; db_pm; } b3 -> db_pm [style=invis]; { rank=same; b8; db_asn; } b8 -> db_asn [style=invis]; { rank=same; b1; db_pp; } b1 -> db_pp [style=invis];
}
