 "general": {
  "objective": [
   "To register, change and delete the Minimum MAD and Case/Day of a crossdock part (TB_M_PART_CROSSDOCK_DTL).",
   "To display the part details with search by Part Number.",
   "This sub-menu is opened by users logged in with a Procurement account, next to the Part List sub-menu."
  ],
  "display_order": [
   {
    "section": "Result List",
    "fields": [
     {
      "field": "Last Update (CHANGED_DT)",
      "order": "Descending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Reset",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "Search",
    "function": "To retrieve records according to the specified criteria. The criteria are applied only when [Search] is clicked (or Enter is pressed in a text box)."
   },
   {
    "name": "Add Detail",
    "function": "Open the 'Add Part Detail' modal (Add Mode), ready to add a new record."
   },
   {
    "name": "Edit",
    "function": "Change the screen into edit mode to modify the selected row ('Edit part detail' modal)."
   },
   {
    "name": "Delete",
    "function": "Delete the selected row after confirmation."
   },
   {
    "name": "Save",
    "function": "Save the record entered in the Add / Edit modal."
   },
   {
    "name": "Cancel",
    "function": "Close the Add / Edit modal without saving."
   },
   {
    "name": "Yes, delete",
    "function": "Confirm the deletion."
   },
   {
    "name": "No",
    "function": "Cancel the deletion."
   },
   {
    "name": "OK",
    "function": "Close the success popup."
   }
  ],
