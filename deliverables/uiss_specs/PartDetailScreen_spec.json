 "operation": [
  {
   "type": "heading",
   "text": "5.1 Initial Display"
  },
  {
   "type": "bullets",
   "marker": "a.",
   "level": 2,
   "items": [
    "The sub-menu is opened by users logged in with a Procurement account, from the tab 'Part Detail' next to 'Part List'.",
    "Retrieve all records of TB_M_PART_CROSSDOCK_DTL with the Part Name of TB_M_PART_CANDIDATE, sorted by CHANGED_DT descending.",
    "If there is no record at all, hide the table and display message no. 2."
   ]
  },
  {
   "type": "heading",
   "text": "5.2 Specifying Criteria"
  },
  {
   "type": "bullets",
   "marker": "a.",
   "level": 2,
   "items": [
    "'Part Number' matches by 'contains', case-insensitive.",
    "If no record matches, hide the table and display message no. 1."
   ]
  },
  {
   "type": "heading",
   "text": "5.3 Add Part Detail"
  },
  {
   "type": "item",
   "marker": "a.",
   "level": 2,
   "text": "User clicks [Add Detail]."
  },
  {
   "type": "bullets",
   "marker": "1.",
   "level": 3,
   "items": [
