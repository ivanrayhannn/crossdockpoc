 "general": {
  "objective": [
   "To replicate TB_R_ACTUAL_DEMAND_SUMMARY from DB Surrounding to the table with the same name in NSP, so the DAD Volume Calculation and the Mapping Destination Calculation read the actual demand inside NSP.",
   "The NSP table is fully replaced every run (delete - insert). In case any error occurs, the run is rolled back and NSP keeps the data of the last successful run."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler (monthly)",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Read source table",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Delete NSP table + insert all rows",
      "type": "process"
     },
     {
      "id": "d",
      "label": "Success?",
      "type": "decision"
     },
     {
      "id": "e",
      "label": "Commit, Log SUCCESS",
      "type": "process"
     },
     {
      "id": "f",
      "label": "Roll back, Log FAILED",
      "type": "process"
     }
    ],
    "edges": [
     {
