 "func_desc_layout": "two",
 "func_desc": [
  {
   "type": "text",
   "level": 0,
   "text": "This batch copies the actual demand summary from DB Surrounding into NSP once a month. Range of months and schedule are set in the system master (not explained in this document)."
  },
  {
   "type": "bullets",
   "marker": "-",
   "level": 0,
   "items": [
    "Full replace: all rows of the NSP table are deleted and all source rows are inserted (delete - insert). No row is compared or merged.",
    "All columns are copied with the same names and values; no conversion is done.",
    "Delete and insert run in one transaction (all-or-nothing). When the run fails, NSP keeps the data of the last successful run.",
    "The batch must finish before the DAD Volume Calculation starts."
   ]
  },
  {
   "type": "column_break"
  },
  {
   "type": "heading",
   "text": "Columns used by Crossdock"
  },
  {
   "type": "table",
   "level": 0,
   "row_lines": "all",
   "columns": [
    {
     "title": "Column",
     "width": 18
    },
    {
     "title": "Used by",
     "width": 28
    }
   ],
   "rows": [
    [
     "GROUPING_BUYER_CD + GROUPING_PD_CD",
     "Mapping Destination Calculation (7-digit destination code)"
    ],
    [
     "ORDER_TYPE_GROUP",
     "N and S are summed"
    ],
    [
     "DEMAND_MONTH_YEAR",
     "Range of months (system master)"
    ],
    [
     "PART_NO",
     "Join to TB_M_PART_CANDIDATE"
    ],
    [
     "MAD",
     "DAD Volume Calculation and Mapping Destination Calculation"
    ]
   ]
  }
 ],
