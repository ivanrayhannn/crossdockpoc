          {
            "title": "Description",
            "width": 35
          }
        ],
        "rows": [
          [
            "Trigger",
            "Job scheduler, once a day at 05:00 (GD-01)."
          ],
          [
            "Sequence",
            "F1 -> F2 -> F3 -> F4 in the same job. F2 to F4 run only if F1 ends successfully."
          ],
          [
            "Re-run",
            "Safe to re-run: existing keys are skipped and the watermark only moves on success."
          ],
          [
            "Dependency",
            "TBD: confirm that the TOPAS load of H0202 always finishes before 05:00."
          ]
        ]
