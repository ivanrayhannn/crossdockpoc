  "general": {
    "objective": [
      "To get new crossdock customer orders (DEMAND_HISTORY_UPDATE_CD = '06') from TB_R_H0202_DEMAND_HISTORY_SUM and insert them into TB_R_CUSTOMER_INSTRUCTION as the base data for Case Consolidation (F2 Cancel Sync, F3 PO Mapping, F4 Case Assignment).",
      "To accept a Customer Order Date only when every part on that date is Active in the Crossdock Part List master. When any part is not Active, the whole Customer Order Date is held in a pending table and checked again in the next runs (GD-04, GD-05).",
      "In case any technical error occurs, all inserted data is rolled back, the watermark is not moved and F2 to F4 are not executed (GD-10)."
    ],
    "operation_flow": {
      "flow": {
        "direction": "TB",
        "nodes": [
          {
            "id": "sch",
            "label": "Job scheduler daily 05:00",
            "type": "event"
          },
          {
            "id": "h",
            "label": "TB_R_H0202_DEMAND_HISTORY_SUM",
            "type": "db"
          },
          {
            "id": "m",
            "label": "MASTER_CANDIDATE_PART",
            "type": "db"
          },
          {
            "id": "f1",
            "label": "F1 Get Data",
            "type": "process"
          },
          {
            "id": "ci",
            "label": "TB_R_CUSTOMER_INSTRUCTION",
            "type": "db"
          },
          {
            "id": "pd",
            "label": "TB_R_CI_PENDING_ORDER_DT",
            "type": "db"
          },
          {
            "id": "nx",
            "label": "F2 Cancel Sync, F3, F4",
            "type": "subprocess"
          }
        ],
        "edges": [
          {
            "from": "sch",
            "to": "f1"
          },
          {
            "from": "h",
            "to": "f1"
          },
          {
            "from": "m",
            "to": "f1"
          },
          {
            "from": "f1",
            "to": "ci",
            "label": "accepted dates"
          },
          {
            "from": "f1",
            "to": "pd",
            "label": "rejected dates"
          },
          {
            "from": "ci",
            "to": "nx",
            "style": "dashed"
          }
        ],
        "same_rank": [
          [
            "h",
            "m"
          ],
          [
            "ci",
            "pd"
          ]
        ]
      },
      "note": "F2 to F4 are outside this document; they run after F1 succeeds in the same 05:00 job."
    },
    "inputs": [
      {
        "name": "TB_R_H0202_DEMAND_HISTORY_SUM",
        "type": "DB",
        "description": "Only DEMAND_HISTORY_UPDATE_CD = '06'. Delta: CREATE_DT later than the watermark (GD-03). Rows of pending Customer Order Dates are read again regardless of the watermark (GD-05)."
      },
      {
        "name": "MASTER_CANDIDATE_PART",
        "type": "DB",
        "description": "Crossdock Part List master. Part must have PART_STATUS = 'Active' (GD-04). Period to read is TBD."
      },
      {
        "name": "TB_R_CUSTOMER_INSTRUCTION",
        "type": "DB",
        "description": "Existing keys; a key that already exists is skipped (insert only, GD-07)."
      },
      {
        "name": "TB_R_CI_PENDING_ORDER_DT",
        "type": "DB",
        "description": "Customer Order Dates held by earlier runs with status P (Pending); processed first, oldest date first (table proposed)."
      },
      {
        "name": "TB_R_CI_BATCH_LOG",
        "type": "DB",
        "description": "WATERMARK_TO of the last successful F1 run (table proposed)."
      }
    ],
    "outputs": [
      {
        "name": "TB_R_CUSTOMER_INSTRUCTION",
        "type": "DB",
        "description": "New order lines of accepted Customer Order Dates, if successful."
      },
      {
        "name": "TB_R_CI_PENDING_ORDER_DT",
        "type": "DB",
        "description": "Rejected Customer Order Dates (insert or re-open) and released dates (status update) (table proposed)."
      },
      {
        "name": "TB_R_CI_BATCH_LOG",
        "type": "DB",
        "description": "One record per run: status, counts, watermark, start/end. Also logs necessary information (table proposed)."
      }
    ],
    "extra_tables": [
