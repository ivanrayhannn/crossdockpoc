 "general": {
  "objective": [
   "To display the delivery plan of crossdock parts per Part Number + Customer Order Date, with its status Ready to Delivery / Waiting for Next PO (from TB_R_INSTRUCTION).",
   "To select one or more Ready to Delivery units, also of different Customer Order Dates, and create one ASN with them.",
   "To review the cases of the ASN (one case per Part Number + Customer Order Date + destination), enter Delivery Date and Rit Cycle, download the case labels and submit the ASN."
  ],
  "display_order": [
   {
    "section": "Delivery plan",
    "fields": [
     {
      "field": "Customer Order Date",
      "order": "Ascending"
     },
     {
      "field": "Part Number",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "Order lines",
    "fields": [
     {
      "field": "Detailed Item No",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "Case List",
    "fields": [
     {
      "field": "Selected unit (Customer Order Date, Part Number)",
      "order": "Ascending"
     },
     {
      "field": "Destination, by first appearance in the unit",
      "order": "-"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "Retrieve the delivery plan by Customer Order Date range, Part Number and Status."
   },
   {
    "name": "Reset",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "Order lines (expand)",
    "function": "Show / hide the customer order lines of a unit with their PO assignment."
   },
   {
    "name": "Clear selection",
    "function": "Untick all selected units."
   },
   {
    "name": "Create ASN",
    "function": "Open the Case List sub screen with all cases of the selected units."
   },
   {
    "name": "Back",
    "function": "Return from the Case List to ASN Crossdock Creation without submitting."
   },
   {
    "name": "Download Case Label",
    "function": "Download the labels of all cases of the ASN. TBD: label format and content."
   },
   {
    "name": "Cancel",
    "function": "Same as Back."
   },
   {
    "name": "Submit ASN",
    "function": "Ask for confirmation, then submit the ASN and lock its units."
   },
   {
    "name": "Yes / No",
    "function": "Confirmation of Submit ASN (Submit? Y / N)."
   },
   {
    "name": "OK",
    "function": "Close the success notification."
   }
  ],
