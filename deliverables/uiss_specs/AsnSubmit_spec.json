 "func_desc_layout": "full",
 "func_desc": [
  {
   "type": "bullets",
   "marker": "-",
   "level": 0,
   "items": [
    "Submit ASN runs as a batch so the screen does not wait; the user sees the Submit ID and checks the result in Log Monitoring. No success popup is shown on X8.",
    "The log follows the existing NSP log (same table and columns); the Submit ID is the key to find the run.",
    "All-or-nothing: on error nothing is saved and the mapping made by [Create ASN] is released, so the units can be selected again.",
    "The submit process (Submit ID, batch call, log) follows the existing ASN submit of NSP."
   ]
  }
 ],
 "logging_messages": [
  {
   "event": "Batch start",
   "cause": "[Submit ASN] Yes",
   "type": "Info",
   "msg_id": "LOG1",
   "message": "ASN submit started. Submit ID <SUBMIT_ID>, <n> cases.",
   "action": {
    "system": "Write the log.",
    "user": "-"
   }
  },
  {
   "event": "Save",
   "cause": "ASN saved",
   "type": "Info",
   "msg_id": "LOG2",
   "message": "<ASN_NO> submitted with status Created. <n> cases are locked. Delivery <DELIVERY_DT> \u00b7 <RIT>. The ASN is shown in ASN Inquiry.",
   "action": {
    "system": "Write the log.",
    "user": "-"
   }
  },
  {
   "event": "Batch end",
   "cause": "Batch finishes",
   "type": "Info",
   "msg_id": "LOG3",
   "message": "ASN submit ended. Status <STATUS>.",
   "action": {
    "system": "Write the log.",
    "user": "-"
   }
  },
  {
   "event": "Error",
   "cause": "Numbering or insert fails / any system error",
   "type": "Error",
   "msg_id": "LOG4",
   "message": "Failed to submit ASN, Submit ID <SUBMIT_ID>: <ERROR_DETAIL>.",
   "action": {
    "system": "Roll back; release the mapping. STATUS = ERROR.",
    "user": "Create the ASN again; contact PIC if it persists."
   }
  }
 ],
