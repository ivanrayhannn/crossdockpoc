 "general": {
  "objective": [
   "To save the ASN of ASN Crossdock Creation (X8) when the user confirms [Submit ASN]: ASN header with status '1' Created and its cases.",
   "The screen does not wait for the result: it shows the Submit ID and the batch writes its messages to the existing log (Log Monitoring). In case any error occurs, nothing is saved (all-or-nothing)."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "[Submit ASN] Yes on X8: Submit ID",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Take ASN No / Case No (existing numbering)",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Insert ASN header and cases",
      "type": "process"
     },
     {
      "id": "d",
      "label": "Commit / roll back, write log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     },
     {
      "from": "c",
      "to": "d"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "Submit ID",
    "type": "Parameter",
    "description": "Generated by X8 at [Submit ASN] Yes (existing ASN submit process); key of the log record"
   },
   {
    "name": "#TEMP_ASN_DRAFT",
    "type": "Temp",
    "description": "ASN draft of the session built by [Create ASN] (cases, lines, Delivery Date, Rit, Route)"
   }
  ],
  "outputs": [
   {
    "name": "TB_R_ASN_CROSSDOCK_H",
    "type": "DB",
    "description": "if successful: one ASN header, ASN_STATUS '1' Created"
   },
   {
    "name": "TB_R_ASN_CROSSDOCK_D",
    "type": "DB",
    "description": "if successful: one row per case x order line x PO"
   },
   {
    "name": "Log (existing)",
    "type": "DB",
    "description": "Start, result and end messages with the Submit ID (existing log format)"
   }
  ],
  "extra_tables": [
   {
    "title": "Parameters",
    "columns": [
     {
      "title": "Name",
      "width": 14
     },
     {
      "title": "Description",
      "width": 34
     }
    ],
    "rows": [
     [
      "Submit ID",
      "Generated by X8; the submit process follows the existing ASN"
     ],
     [
      "User ID",
      "Login user of X8"
     ]
    ]
   },
   {
    "title": "Execution Schedule",
    "columns": [
     {
      "title": "Item",
      "width": 12
     },
     {
      "title": "Description",
      "width": 36
     }
    ],
    "rows": [
     [
      "Trigger",
      "On demand: [Submit ASN] Yes on ASN Crossdock Creation (X8). No scheduler."
     ]
    ]
   }
  ]
 },
 "func_flow": {
  "flow": {
   "direction": "TB",
   "nodes": [
    {
     "id": "p1",
     "label": "Start (Submit ID)",
     "type": "process",
     "step": 1
    },
    {
