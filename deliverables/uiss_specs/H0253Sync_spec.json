 "appendix": [],
 "tables": [
  {
   "name": "TB_R_H0253_ORDER_CONTROL_PRE",
   "kind": "transaction",
   "proposed": false,
   "description": "Order control data, pre-order picking info (I/F H02-53, DVJO950) replicated from DB Surrounding. Structure from the T-System I/F layout; physical names follow the existing table. Key (PK) = unique key of the I/F layout.",
   "columns": [
    [
     "CUSTOMER_CD",
     "VARCHAR(7)",
     "Y",
     "N",
     "No.1 Customer Code"
    ],
    [
     "CUSTOMER_ORDER_NO",
     "VARCHAR(8)",
     "Y",
     "N",
     "No.2 Customer Order No."
    ],
    [
     "ORDER_DT",
     "DATE",
     "Y",
     "N",
     "No.3 Order Date"
    ],
    [
     "ORDER_TIME",
     "VARCHAR(6)",
     "Y",
     "N",
     "No.4 Order Time"
    ],
    [
     "DESTINATION_CD",
     "VARCHAR(7)",
     "Y",
     "N",
     "No.5 Destination Code"
    ],
    [
     "DETAILED_ITEM_NO",
     "VARCHAR(4)",
     "Y",
     "N",
     "No.6 Detailed Item No."
    ],
    [
     "SERIAL_NO",
     "VARCHAR(7)",
     "Y",
     "N",
     "No.7 Serial No., Card No. Part of the key; distinguishes split records of the same order line (taken from the I/F layout, not in the current table export)."
    ],
    [
     "TOPAS_ORDER_TYPE",
     "VARCHAR(1)",
     "",
     "Y",
     "No.8 TOPAS Order Type: '1': VOR, '2': E/O, '3': S/O, 'F': F/O"
    ],
    [
     "DEMAND_HISTORY_UPDATE_DT",
     "DATE",
     "",
     "Y",
     "No.9 Demand History Update Date"
    ],
    [
     "SHIPPING_MAKER_CD",
     "VARCHAR(1)",
     "",
     "Y",
     "No.10 Shipping Maker Code"
    ],
    [
     "SHIPPING_PART_NO",
     "VARCHAR(15)",
     "",
     "Y",
     "No.11 Shipping P/No."
    ],
    [
     "ORIGINAL_SHIPPING_QTY",
     "NUMBER(8)",
