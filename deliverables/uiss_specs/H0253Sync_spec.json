 "general": {
  "objective": [
   "To replicate TB_R_H0253_ORDER_CONTROL_PRE from DB Surrounding to the table with the same name in Supplier System.",
   "The Supplier System table is fully replaced every run (delete - insert). In case any error occurs, the run is rolled back and Supplier System keeps the data of the last successful run."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Delete + insert TB_R_H0253_ORDER_CONTROL_PRE",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Commit / roll back, Log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE (DB Surrounding)",
    "type": "DB",
    "description": "Order control data, pre-order picking info (I/F H02-53, DVJO950)"
   }
  ],
  "outputs": [
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE (Supplier System)",
    "type": "DB",
    "description": "if successful: same rows as the source"
   },
   {
    "name": "Log",
    "type": "DB",
    "description": "One record per run with status SUCCESS / FAILED"
   }
  ],
