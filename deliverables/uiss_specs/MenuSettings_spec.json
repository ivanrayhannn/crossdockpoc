 "general": {
  "objective": [
   "To let the admin choose which menus are shown in the sidebar.",
   "Changes apply at once; Menu Settings itself is always shown so hidden menus can be shown again."
  ],
  "display_order": [
   {
    "section": "Menu groups",
    "fields": [
     {
      "field": "Sidebar order of groups and menus",
      "order": "-"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Show (check box)",
    "function": "Show (ticked) or hide (unticked) one menu."
   },
   {
    "name": "Show all (group)",
    "function": "Show every menu of the group."
   },
   {
    "name": "Hide all (group)",
    "function": "Hide every menu of the group (except Menu Settings)."
   },
   {
    "name": "Show all",
    "function": "Show every menu of the sidebar."
   }
  ],
  "screen_modes": [
