     {
      "section": "Menu groups",
      "description": "One card per sidebar group with its menus",
      "buttons": {
       "Show (check box)": "E",
       "Show all (group)": "E",
       "Hide all (group)": "E",
       "Show all": "D"
      }
     }
    ]
   }
  ],
  "screen_mode_remarks": [
   "1) The check box of Menu Settings is disabled ('always shown').",
   "2) [Show all] is disabled when no menu is hidden."
  ]
