 "general": {
  "objective": [
   "To search the ASNs submitted in ASN Crossdock Creation (X8).",
   "To display the cases of one ASN (read only) and download its case labels."
  ],
  "display_order": [
   {
    "section": "ASN list",
    "fields": [
     {
      "field": "Submit date-time (CREATED_DT)",
      "order": "Descending"
     }
    ]
   },
   {
    "section": "Cases",
    "fields": [
     {
      "field": "Case No",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "Retrieve ASNs by ASN No, Delivery Date range and Part Number."
   },
   {
    "name": "Reset",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "ASN No (link)",
    "function": "Open the detail of the ASN."
   },
   {
    "name": "Back",
    "function": "Return from the detail to the ASN list."
   },
   {
    "name": "Download Case Label",
    "function": "Download the labels of all cases of the ASN. TBD: label format."
   }
  ],
  "screen_modes": [
   {
    "mode": "List Mode",
    "sections": [
     {
      "section": "Search Criteria",
      "description": "Criteria blank; all ASNs listed",
      "buttons": {
       "Search": "E",
       "Reset": "E",
       "ASN No (link)": "D",
       "Back": "D",
       "Download Case Label": "D"
      }
     },
     {
      "section": "ASN list",
      "description": "One row per ASN",
      "buttons": {
       "Search": "D",
       "Reset": "D",
       "ASN No (link)": "E",
       "Back": "D",
       "Download Case Label": "D"
      }
     }
    ]
   },
   {
    "mode": "Detail Mode",
    "sections": [
     {
      "section": "ASN summary",
      "description": "Delivery Date, Rit Cycle, units, cases / qty, created",
      "buttons": {
       "Search": "D",
       "Reset": "D",
       "ASN No (link)": "D",
       "Back": "E",
       "Download Case Label": "D"
      }
     },
     {
      "section": "Cases",
      "description": "Read-only case list",
      "buttons": {
       "Search": "D",
       "Reset": "D",
       "ASN No (link)": "D",
       "Back": "D",
       "Download Case Label": "E"
      }
     }
    ]
   }
  ]
