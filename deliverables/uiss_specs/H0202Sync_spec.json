      "id": "b",
      "label": "Delete + insert TB_R_H0202_DEMAND_HISTORY_SUM",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Commit / roll back, Log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     }
    ]
   }
  },
