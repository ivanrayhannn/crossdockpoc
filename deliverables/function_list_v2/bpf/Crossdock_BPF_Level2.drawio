ounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="297" y="413" width="26" height="12" as="geometry"/></mxCell><mxCell id="F4_H3" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;XD09&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;[Search]: lines with HOLD_FLAG Y are excluded from pre-mapping; the unit calculation excludes the held destination(s)&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#DBE5F4;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="500" y="178" width="161" height="93" as="geometry"/></mxCell><mxCell id="c27" value="H3" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="497" y="171" width="26" height="12" as="geometry"/></mxCell><mxCell id="F4_H4" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;XD10&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;[Create ASN] re-checks the hold: a line held after the tick → whole create fails, list refreshed&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="700" y="536" width="161" height="78" as="geometry"/></mxCell><mxCell id="c29" value="H4" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="697" y="529" width="26" height="12" as="geometry"/></mxCell><mxCell id="c30" value="AB09" style="rounded=0;fillColor=#C00000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="829" y="529" width="31" height="12" as="geometry"/></mxCell><mxCell id="F4_H5" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;XD10&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Release the destination: HOLD_FLAG = N&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="161" height="78" as="geometry"/></mxCell><mxCell id="c32" value="H5" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="897" y="413" width="26" height="12" as="geometry"/></mxCell><mxCell id="F4_H6" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;XD09&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Next [Search]: released lines are automatically included in pre-mapping and unit calculation (unit qty increases by their qty)&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#DBE5F4;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1100" y="178" width="161" height="93" as="geometry"/></mxCell><mxCell id="c34" value="H6" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1097" y="171" width="26" height="12" as="geometry"/></mxCell><mxCell id="F4_C1" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;SOP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Check the ASN feedback: only qty not yet in an ASN may be cancelled&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2F5597&quot;&gt;R: Existing ASN feedback&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1300" y="47" width="161" height="93" as="geometry"/></mxCell><mxCell id="c36" value="C1" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1297" y="40" width="26" height="12" as="geometry"/></mxCell><mxCell id="F4_C2" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;Source&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Cancel (with or without HOLD_FLAG): ORDER_STATUS 2; partial cancel = new SERIAL_NO&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7B3F00&quot;&gt;W: TB_R_H0253_ORDER_CONTROL_PRE (DB Surrounding, INTF_UPDATE_DT)&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1500" y="47" width="161" height="93" as="geometry"/></mxCell><mxCell id="c38" value="C2" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1497" y="40" width="26" height="12" as="geometry"/></mxCell><mxCell id="c39" value="AB16" style="rounded=0;fillColor=#C00000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1629" y="40" width="31" height="12" as="geometry"/></mxCell><mxCell id="F4_C3" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;XD08&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Upsert the changed rows: UPD_STATUS 2 (cancel) / 6 (received); ORDER_STATUS keeps the first value&lt;/font&gt;" style="shape=card;flipH=1;size=10;whiteSpace=wrap;html=1;fillColor=#DBE5F4;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1700" y="178" width="161" height="93" as="geometry"/></mxCell><mxCell id="c41" value="C3" style="rounded=0;fillColor=#000000;strokeColor=#C00000;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1697" y="171" width="26" height="12" as="geometry"/></mxCell><mxCell id="c42" value="AB07" style="rounded=0;fillColor=#C00000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1829" y="171" width="31" height="12" as="geometry"/></mxCell><mxCell id="F4_C4" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;XD08&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;Release all draf