      "buttons": {
       "Search": "D",
       "Reset": "D",
       "ASN No (link)": "E",
       "Back": "D",
       "Download Case Label": "D"
      }
     }
    ]
   },
   {
    "mode": "Detail Mode",
    "sections": [
