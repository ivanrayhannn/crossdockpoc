 "general": {
  "objective": [
   "To search the ASNs submitted in ASN Crossdock Creation (XD10).",
   "To display the cases of one ASN (read only) and download its case labels."
  ],
  "display_order": [
   {
    "section": "ASN list",
    "fields": [
     {
      "field": "Submit date-time (CREATED_DT)",
      "order": "Descending"
     }
    ]
   },
   {
    "section": "Cases",
    "fields": [
     {
      "field": "Case No",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "Retrieve ASNs by ASN No, Delivery Date range and Part Number."
   },
   {
    "name": "Reset",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "ASN No (link)",
    "function": "Open the detail of the ASN."
   },
   {
    "name": "Back",
    "function": "Return from the detail to the ASN list."
   },
   {
    "name": "Download Case Label",
    "function": "Download the labels of all cases of the ASN. Label format follows the existing case label: 1 case label = 1 case of 1 destination, may list several customer order numbers."
   }
  ],
  "screen_modes": [
   {
    "mode": "List Mode",
    "sections": [
     {
      "section": "Search Criteria",
      "description": "Criteria blank; all ASNs listed",
      "buttons": {
