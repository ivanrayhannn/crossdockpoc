 "doc_type": "batch",
 "general": {
  "objective": [
   "To replicate the rows of TB_R_H0253_ORDER_CONTROL_PRE (DB Surrounding) with ORDER_STATUS = '7' (cross dock orders, used for the ASN) into TB_R_H0253_ORDER_CONTROL_PRE in NSP.",
   "The NSP table is fully replaced every run (delete - insert). In case any error occurs, the run is rolled back and NSP keeps the data of the last successful run.",
   "Only crossdock orders (status 7) are taken. Cancelled lines (status 2) are taken by F12 and processed by F11 before this batch runs."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler (job chain)",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Delete + insert TB_R_H0253_ORDER_CONTROL_PRE (ORDER_STATUS = '7')",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Commit / roll back, Log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE (DB Surrounding)",
    "type": "DB",
    "description": "Order control data, pre-order picking info (I/F H02-53, DVJO950); rows with ORDER_STATUS = '7'"
   }
  ],
  "outputs": [
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE (NSP)",
    "type": "DB",
    "description": "if successful: the source rows with ORDER_STATUS = '7'"
   },
   {
    "name": "Log",
    "type": "DB",
    "description": "One record per run with status SUCCESS / FAILED"
   }
  ],
  "extra_tables": [
   {
    "title": "Parameters",
    "columns": [
