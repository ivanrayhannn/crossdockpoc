      "width": 14
     },
     {
      "title": "Description",
      "width": 34
     }
    ],
    "rows": [
     [
      "Order status",
      "'7' (cross dock orders, used for the ASN); fixed in this batch"
     ]
    ]
   },
   {
    "title": "Execution Schedule",
    "columns": [
