     "VARCHAR(7)",
     "Y",
     "N",
     "No.5 Destination Code"
    ],
    [
     "DETAILED_ITEM_NO",
     "VARCHAR(4)",
     "Y",
     "N",
     "No.6 Detailed Item No."
    ],
    [
     "SERIAL_NO",
     "VARCHAR(7)",
     "Y",
     "N",
     "No.7 Serial No., Card No. Part of the key; distinguishes split records of the same order line (taken from the I/F layout, not in the current table export)."
    ],
    [
     "TOPAS_ORDER_TYPE",
     "VARCHAR(1)",
     "",
     "Y",
     "No.8 TOPAS Order Type: '1': VOR, '2': E/O, '3': S/O, 'F': F/O"
    ],
    [
     "DEMAND_HISTORY_UPDATE_DT",
     "DATE",
     "",
     "Y",
     "No.9 Demand History Update Date"
    ],
    [
     "SHIPPING_MAKER_CD",
     "VARCHAR(1)",
     "",
     "Y",
     "No.10 Shipping Maker Code"
    ],
    [
     "SHIPPING_PART_NO",
     "VARCHAR(15)",
     "",
     "Y",
     "No.11 Shipping P/No."
    ],
    [
     "ORIGINAL_SHIPPING_QTY",
     "NUMBER(8)",
     "",
     "Y",
     "No.12 Original Shipping Qty or Estimated Shipping Qty"
    ],
    [
     "ORDER_STATUS_QTY",
     "NUMBER(8)",
     "",
     "Y",
     "No.13 Order Status Qty"
    ],
    [
     "ORDER_STATUS",
     "VARCHAR(1)",
     "",
     "Y",
