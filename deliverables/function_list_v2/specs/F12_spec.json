 "doc_type": "batch",
 "general": {
  "objective": [
   "To replicate the rows of TB_R_H0253_ORDER_CONTROL_PRE (DB Surrounding) with ORDER_STATUS = '2' (cancelled orders) into TB_R_H0253_ORDER_CANCEL_PRE in NSP.",
   "The NSP table is fully replaced every run (delete - insert). In case any error occurs, the run is rolled back and NSP keeps the data of the last successful run.",
   "The table is read by F11 Cancel Crossdock Customer Order Batch, which processes the cancel of crossdock lines in NSP."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler (job chain)",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Delete + insert TB_R_H0253_ORDER_CANCEL_PRE (ORDER_STATUS = '2')",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Commit / roll back, Log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE (DB Surrounding)",
    "type": "DB",
    "description": "Order control data, pre-order picking info (I/F H02-53, DVJO950); rows with ORDER_STATUS = '2'"
   }
  ],
  "outputs": [
   {
    "name": "TB_R_H0253_ORDER_CANCEL_PRE (NSP)",
    "type": "DB",
    "description": "if successful: the source rows with ORDER_STATUS = '2'"
   },
   {
    "name": "Log",
    "type": "DB",
    "description": "One record per run with status SUCCESS / FAILED"
   }
  ],
  "extra_tables": [
   {
    "title": "Parameters",
    "columns": [
