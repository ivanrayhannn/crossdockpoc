   "name": "TB_R_H0253_ORDER_CANCEL_PRE",
   "kind": "transaction",
   "proposed": true,
   "description": "Rows of H0253 with ORDER_STATUS = '2' replicated from DB Surrounding. Structure from the G-TOPAS I/F layout; physical names follow the existing table. Key (PK) = unique key of the I/F layout. Table name proposed.",
   "columns": [
    [
     "CUSTOMER_CD",
     "VARCHAR(7)",
     "Y",
     "N",
     "No.1 Customer Code"
    ],
    [
     "CUSTOMER_ORDER_NO",
     "VARCHAR(8)",
     "Y",
     "N",
     "No.2 Customer Order No."
    ],
    [
     "ORDER_DT",
     "DATE",
     "Y",
     "N",
     "No.3 Order Date"
    ],
    [
     "ORDER_TIME",
     "VARCHAR(6)",
     "Y",
     "N",
     "No.4 Order Time"
    ],
    [
