   ]
  },
  "steps": [
   "The scheduler starts the batch.",
   "Delete all rows of TB_M_H0125_DESTINATION (NSP) and insert all rows of TB_M_H0125_DESTINATION (DB Surrounding) (same columns and values).",
   "No error: commit. Error: roll back step 2 (one transaction). Record the result in the Log. Exit."
  ]
 },
