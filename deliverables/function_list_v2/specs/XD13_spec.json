 "general": {
  "objective": [
   "To replicate TB_M_H0125_DESTINATION from DB Surrounding to the table with the same name in NSP.",
   "The NSP table is fully replaced every run (delete - insert). In case any error occurs, the run is rolled back and NSP keeps the data of the last successful run."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Delete + insert TB_M_H0125_DESTINATION",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Commit / roll back, Log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "TB_M_H0125_DESTINATION (DB Surrounding)",
    "type": "DB",
    "description": "Destination master (I/F H01-25, DVJO820)"
   }
  ],
  "outputs": [
   {
    "name": "TB_M_H0125_DESTINATION (NSP)",
    "type": "DB",
    "description": "if successful: same rows as the source"
   },
   {
    "name": "Log",
    "type": "DB",
    "description": "One record per run with status SUCCESS / FAILED"
   }
  ],
  "extra_tables": [
   {
    "title": "Parameters",
    "columns": [
     {
      "title": "Name",
      "width": 14
     },
     {
      "title": "Description",
      "width": 34
     }
    ],
    "rows": [
     [
      "-",
      "No parameter. All rows of the source table are copied."
     ]
    ]
   },
   {
    "title": "Execution Schedule",
    "columns": [
