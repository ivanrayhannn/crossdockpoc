   "event": "Judge",
   "cause": "Cancel applied (qty in ASN <= valid qty)",
   "type": "Info",
   "msg_id": "LOG3",
   "message": "Customer order <CUSTOMER_ORDER_NO> <PART_NO> cancelled <CANCEL_QTY> pcs; valid <VALID_QTY> pcs; mapping released <RELEASED_QTY> pcs.",
   "action": {
    "system": "Continue.",
    "user": "-"
   }
  },
  {
   "event": "Judge",
   "cause": "Qty in ASN > valid qty (abnormality)",
   "type": "Error",
   "msg_id": "LOG4",
   "message": "Cancel conflict <CUSTOMER_ORDER_NO> <PART_NO>: <CONFLICT_QTY> pcs of <ASN_NO> have no order after the cancel.",
   "action": {
    "system": "Release the open mapping; ASN not changed. Continue.",
    "user": "D/S team handles the shipped case at receiving."
   }
  },
  {
   "event": "Save",
   "cause": "Delete / update / insert of a line fails",
   "type": "Error",
   "msg_id": "LOG5",
   "message": "Cannot process the cancel of <CUSTOMER_ORDER_NO> <PART_NO>: <ERROR_DETAIL>.",
   "action": {
    "system": "Roll back the line; rows stay 'P' and are processed by the next run.",
    "user": "User contact PIC if it persists"
   }
  },
  {
   "event": "Unexpected error",
   "cause": "Any other system error",
   "type": "Critical",
   "msg_id": "LOG6",
   "message": "Unexpected error: <ERROR_DETAIL>.",
   "action": {
    "system": "Stop. STATUS = ERROR. XD08 is not started.",
    "user": "User contact PIC"
   }
  }
 ],
