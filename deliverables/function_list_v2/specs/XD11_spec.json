      "Line",
      "CUSTOMER_CD + CUSTOMER_ORDER_NO + ORDER_DT + ORDER_TIME + DESTINATION_CD + DETAILED_ITEM_NO (unique key without SERIAL_NO)"
     ],
     [
      "CANCEL_QTY",
      "Sum of ORDER_STATUS_QTY of the status 2 rows with CANCEL_STATUS 'P'"
     ],
     [
      "VALID_QTY",
      "Sum of ORDER_STATUS_QTY of the rows with status 7 or 6"
     ],
     [
      "QTY_IN_ASN",
      "Sum of QTY of the rows of the line in TB_R_INSTRUCTION with ASN_NO"
     ],
     [
      "QTY_OPEN",
      "Sum of QTY of the rows of the line in TB_R_INSTRUCTION without ASN_NO"
     ],
     [
      "CONFLICT_QTY",
      "QTY_IN_ASN - VALID_QTY when positive, else 0"
     ]
    ]
   },
   {
    "title": "Result Rule",
    "columns": [
     {
      "title": "Result",
      "width": 10
     },
     {
      "title": "Condition",
      "width": 20
     },
     {
      "title": "Action",
      "width": 18
     }
    ],
    "rows": [
     [
      "CANCELLED",
      "QTY_IN_ASN <= VALID_QTY (with or without hold)",
      "Open mapping released; valid qty mapped again by XD09"
     ],
     [
      "CONFLICT",
      "QTY_IN_ASN > VALID_QTY (abnormality: cancel of qty already in an ASN)",
      "Open mapping released; ASN not changed; error to D/S"
     ]
    ]
   },
   {
    "title": "Execution Schedule",
    "columns": [
     {
      "title": "Item",
      "width": 12
     },
     {
      "title": "Description",
      "width": 36
     }
    ],
    "rows": [
     [
      "Trigger",
      "Scheduler, daily after G-TOPAS has provided the data (27:30); auto retry 3 times."
     ],
     [
      "Order",
      "Job chain: XD12 -> XD11 -> XD08."
     ],
     [
      "Condition",
      "Runs only when XD12 succeeded."
     ]
    ]
   }
  ]
 },
