 "doc_type": "batch",
 "general": {
  "objective": [
   "To apply in NSP the cancel of crossdock customer order lines done in G-TOPAS (H0253 order status '2', replicated by XD12). NSP does not cancel orders. A line can be cancelled with or without HOLD_FLAG = 'Y' (decided 18-Oct).",
   "Qty of the line that is not in a submitted ASN: the mapping is released (TB_R_INSTRUCTION rows without ASN No are deleted, MAPPED_QTY of the PO is reduced) so the PO qty can be used by the next orders.",
   "Qty already in a submitted ASN: the ASN is not changed (cannot be cancelled in NSP); the line is reported as a cancel conflict to the D/S team, who handles the shipped case at receiving.",
   "Rule: a line can be cancelled with or without hold; qty already in a submitted ASN should not be cancelled (detail to be discussed)."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler: after XD12, before XD08",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Cancelled crossdock lines not yet processed",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Qty in ASN vs cancel qty",
      "type": "decision"
     },
     {
      "id": "e",
      "label": "CANCELLED: release mapping",
      "type": "process"
     },
     {
      "id": "f",
      "label": "CONFLICT: release open mapping, report to D/S",
      "type": "process"
     },
     {
      "id": "g",
      "label": "Result, Log",
      "type": "process"
     }
    ],
