 "doc_type": "batch",
 "general": {
  "objective": [
   "To apply in NSP the cancel of crossdock customer order lines done in G-TOPAS (status '2', brought in by XD12 with CANCEL_STATUS 'P'). NSP does not cancel orders; a line can be cancelled with or without HOLD_FLAG = 'Y'.",
   "Per line (all SERIAL_NO of the line, because a partial cancel splits the line): the open mapping of the line (mapped by [Create ASN], not submitted) is released, so the remaining valid qty is pre-mapped again by XD09.",
   "Qty already in a submitted ASN cannot be cancelled: G-TOPAS blocks it by the existing ASN feedback and the D/S team follows the SOP. If it still happens (abnormality), the ASN is not changed and the line is reported as CONFLICT to the D/S team."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "Scheduler: after XD12, before XD08",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Lines with CANCEL_STATUS 'P'",
      "type": "process"
     },
     {
      "id": "c",
      "label": "Release open mapping of the line",
      "type": "process"
     },
     {
      "id": "d",
      "label": "Qty in ASN > valid qty?",
      "type": "decision"
     },
     {
      "id": "e",
      "label": "CANCELLED",
      "type": "process"
     },
     {
      "id": "f",
      "label": "CONFLICT: report to D/S",
      "type": "process"
     },
     {
      "id": "g",
      "label": "CANCEL_STATUS 'D', result, Log",
      "type": "process"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     },
     {
      "from": "c",
      "to": "d"
     },
     {
      "from": "d",
      "to": "e",
      "label": "No"
     },
     {
      "from": "d",
      "to": "f",
      "label": "Yes"
     },
     {
      "from": "e",
      "to": "g"
     },
     {
      "from": "f",
      "to": "g"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE",
    "type": "DB",
    "description": "Status 2 rows with CANCEL_STATUS 'P' (XD12) and all other rows of the same lines (status 7 / 6)"
   },
   {
    "name": "TB_R_INSTRUCTION",
    "type": "DB",
    "description": "Mapping rows of the line; ASN_NO filled = in a submitted ASN"
   },
   {
    "name": "TB_R_PRA_DAILY_ORDER_MAPPED",
    "type": "DB",
    "description": "MAPPED_QTY per PO part"
   }
  ],
  "outputs": [
   {
    "name": "TB_R_INSTRUCTION",
    "type": "DB",
    "description": "Open mapping rows of the line deleted"
   },
   {
    "name": "TB_R_PRA_DAILY_ORDER_MAPPED",
    "type": "DB",
    "description": "MAPPED_QTY reduced by the released qty per PO"
   },
   {
    "name": "TB_R_H0253_ORDER_CONTROL_PRE",
    "type": "DB",
    "description": "CANCEL_STATUS 'D' on the processed rows; PO_MAPPED_FLAG 'N' on rows of the line without mapping left"
   },
   {
    "name": "TB_R_CROSSDOCK_CANCEL_RESULT",
    "type": "DB",
    "description": "One record per processed status 2 row (CANCELLED / CONFLICT)"
   },
   {
    "name": "Log",
    "type": "DB",
    "description": "Start, cancel per line, conflicts and end messages"
   }
  ],
  "extra_tables": [
